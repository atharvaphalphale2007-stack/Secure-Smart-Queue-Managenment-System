# ==============================================================================
# Secure Smart Queue Management System (SQMS) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the server in development or production.
# NEVER commit your actual .env file or real secrets to source control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=4000

# Persistent SQLite Database Configuration
# Defaults to server/data/sqms.db when omitted
DB_PATH=./data/sqms.db

# Cryptographic Token & Authentication Secrets
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_hmac_sha256_key_at_least_32_bytes_long_change_in_production
QR_HMAC_SECRET=your_super_secret_qr_signature_hmac_sha256_key_change_in_production

# JWT Expiration Lifetime (e.g., 2h, 8h, 24h)
JWT_EXPIRES_IN=8h

# CORS Configuration (Restrict to office origin in production)
# Example: https://sqms.pune.gov.in
CORS_ORIGIN=http://localhost:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Turn Notification Reminders (in minutes before appointment)
TURN_REMINDER_WINDOW_1_MINS=30
TURN_REMINDER_WINDOW_2_MINS=15

# SMS Notification Gateway (Government NIC / Telecom Provider)
# Set to 'true' only after official API credentials are provided and provisioned
SMS_DELIVERY_ENABLED=false
SMS_GATEWAY_PROVIDER=GOV_SMS_NIC_GATEWAY_STAGING
SMS_API_ENDPOINT=https://mgov.gov.in/api/v2/sms/send
SMS_API_KEY=
SMS_SENDER_ID=GOVSQM

# File Upload Policies
MAX_UPLOAD_FILE_SIZE_MB=5
ALLOWED_DOCUMENT_MIMES=application/pdf,image/jpeg,image/png
UPLOAD_STORAGE_PATH=./src/uploads
