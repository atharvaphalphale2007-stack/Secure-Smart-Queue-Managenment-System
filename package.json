{
  "name": "smart-queue-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/src/index.js",
    "test:server": "npm --prefix server test",
    "backup": "npm --prefix server run backup",
    "restore": "npm --prefix server run restore",
    "build": "vite build",
    "package": "powershell -ExecutionPolicy Bypass -File scripts/package-project.ps1",
    "generate": "npm run build && npm run package",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
